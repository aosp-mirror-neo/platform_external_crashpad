load("//:copts.bzl", "CRASHPAD_COMMON_COPTS", "collect_plugins")

licenses(["notice"])

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = [
        "//:__subpackages__",
        "//:clients",
    ],
)

cc_library(
    name = "common_apple_hdrs",
    hdrs = [
        "crash_report_database.h",
        "settings.h",
    ],
    include_prefix = "client",
    target_compatible_with = ["@platforms//os:macos"],
)

objc_library(
    name = "common_apple",
    srcs = [
        "crash_report_database_mac.mm",
    ],
    applicable_licenses = ["//third_party/xnu:license"],
    copts = CRASHPAD_COMMON_COPTS + [
        "-fobjc-call-cxx-cdtors",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":common_apple_hdrs",
        "//third_party/mini_chromium:base",
        "//util",
    ],
    alwayslink = False,
)

cc_library(
    name = "common_hdrs",
    hdrs = [
        "annotation.h",
        "annotation_list.h",
        "crash_report_database.h",
        "crashpad_info.h",
        "length_delimited_ring_buffer.h",
        "ring_buffer_annotation.h",
        "settings.h",
        "simple_address_range_bag.h",
        "simple_string_dictionary.h",
    ],
    include_prefix = "client",
)

cc_library(
    name = "common_base",
    srcs = [
        "annotation.cc",
        "annotation_list.cc",
        "crash_report_database.cc",
        "crashpad_info.cc",
        "settings.cc",
    ] + select({
        "@platforms//os:linux": ["crashpad_info_note.S"],
        "//conditions:default": [],
    }),
    hdrs = [
        "annotation.h",
        "annotation_list.h",
        "crash_report_database.h",
        "crashpad_info.h",
        "settings.h",
        "simple_address_range_bag.h",
        "simple_string_dictionary.h",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":common_hdrs",
        "//compat",
        "//third_party/mini_chromium:base",
        "//util",
    ],
)

cc_library(
    name = "common_linux",
    srcs = [
        "crash_report_database_generic.cc",
    ],
    copts = CRASHPAD_COMMON_COPTS + ["-Wno-class-memaccess"],
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":common_base"],
)

cc_library(
    name = "common_windows",
    srcs = ["crash_report_database_win.cc"],
    copts = CRASHPAD_COMMON_COPTS,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":common_base"],
)

cc_library(
    name = "common_mac_lib",
    applicable_licenses = ["//third_party/xnu:license"],
    target_compatible_with = ["@platforms//os:osx"],
    deps = [
        ":common_apple",
        ":common_base",
    ],
)

cc_library(
    name = "common",
    deps = [":common_base"] + select({
        "@platforms//os:linux": [":common_linux"],
        "@platforms//os:windows": [":common_windows"],
        "@platforms//os:osx": [":common_mac_lib"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "ring_buffer_annotation_load_test",
    srcs = ["ring_buffer_annotation_load_test_main.cc"],
    deps = [
        ":client",
        "//third_party/getopt",
        "//tools:tool_support",
    ],
)

cc_library(
    name = "client_base",
    srcs = [
        "prune_crash_reports.cc",
    ],
    hdrs = [
        "annotation.h",
        "annotation_list.h",
        "crash_report_database.h",
        "crashpad_client.h",
        "crashpad_info.h",
        "prune_crash_reports.h",
        "settings.h",
        "simple_address_range_bag.h",
        "simple_string_dictionary.h",
        "simulate_crash.h",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":common",
        "//:internal",
        "//compat",
        "//third_party/mini_chromium:base",
        "//util",
    ],
)

cc_library(
    name = "client_mac",
    srcs = [
        "crashpad_client_mac.cc",
        "simulate_crash_mac.cc",
        "simulate_crash_mac.h",
    ],
    applicable_licenses = ["//third_party/xnu:license"],
    copts = CRASHPAD_COMMON_COPTS,
    target_compatible_with = ["@platforms//os:osx"],
    deps = [":client_base"],
)

cc_library(
    name = "client_linux",
    srcs = [
        "client_argv_handling.cc",
        "client_argv_handling.h",
        "crashpad_client_linux.cc",
        "simulate_crash_linux.h",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    linkstatic = True,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":client_base",
        "//third_party/lss",
    ],
)

cc_library(
    name = "client_windows",
    srcs = [
        "crashpad_client_win.cc",
        "simulate_crash_win.h",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    linkopts = ["-defaultlib:rpcrt4.lib"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":client_base"],
)

cc_library(
    name = "client",
    linkopts = select({
        "@platforms//os:windows": [],  # Already in client_windows
        "//conditions:default": ["-pthread"],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        "@platforms//os:osx": [":client_mac"],
        "@platforms//os:linux": [":client_linux"],
        "@platforms//os:windows": [":client_windows"],
        "//conditions:default": [":client_base"],
    }),
)

cc_library(
    name = "pthread_create",
    srcs = ["pthread_create_linux.cc"],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    deps = [
        ":client",
        "//third_party/mini_chromium:base",
        "//util:no_cfi_icall",
    ],
)

collect_plugins(
    name = "plugins",
    output_dir = ".",
    plugins = [
        "//handler:crashpad_handler",
    ],
)

collect_plugins(
    name = "plugins_win",
    output_dir = ".",
    plugins = [
        "//handler:crashpad_handler.com",
    ],
)

cc_test(
    name = "crashpad_client_test",
    srcs = [
        "annotation_list_test.cc",
        "annotation_test.cc",
        "crash_report_database_test.cc",
        "crashpad_info_test.cc",
        "length_delimited_ring_buffer_test.cc",
        "prune_crash_reports_test.cc",
        "ring_buffer_annotation_test.cc",
        "settings_test.cc",
        "simple_address_range_bag_test.cc",
        "simple_string_dictionary_test.cc",
    ] + select({
        "@platforms//os:linux": ["crashpad_client_linux_test.cc"],
        "@platforms//os:osx": ["simulate_crash_mac_test.cc"],
        "@platforms//os:windows": ["crashpad_client_win_test.cc"],
        "//conditions:default": [],
    }),
    copts = CRASHPAD_COMMON_COPTS,
    data = [
        ":plugins",
    ] + select({
        "@platforms//os:windows": [":plugins_win"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": ["-defaultlib:shell32.lib"],
        "//conditions:default": [],
    }),
    # We will not be able to retrieve proper process info on linux in a sandboxed environment
    # causing test failures.
    tags = ["no-sandbox"],
    deps = [
        ":client",
        "//compat",
        "//snapshot",
        "//test",
        "//test:googletest_main",
        "//third_party/mini_chromium:base",
        "//util",
        "@googletest//:gtest",
    ],
)
