  "separate_fn_TARGET_with_space": false,
  "always_wrap": [],
  "separate_ctrl_TARGET_with_space": false,
  "max_subgroups_hwrap": 10,
  "fence_pattern": "^\\s*([`~]{3}[`~]*)(.*)$",
  "enable_markup": true,
  "enable_sort": true,
  "ruler_pattern": "^\\s*[^\\w\\s]{3}.*[^\\w\\s]{3}$",
  "tab_size": 2,
  "keyword_case": "unchanged",
  "enum_char": ".",
  "literal_comment_pattern": null,
  "bullet_char": "*",
  "line_ending": "unix"
