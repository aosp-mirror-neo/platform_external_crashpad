cc_library(
    name = "headers",
    hdrs = SNAPSHOT_HDRS_COMMON + select({
        "@platforms//os:linux": SNAPSHOT_HDRS_LINUX + SNAPSHOT_HDRS_POSIX + SNAPSHOT_HDRS_X86,
        "@platforms//os:osx": SNAPSHOT_HDRS_MAC + SNAPSHOT_HDRS_POSIX,
        "@platforms//os:windows": SNAPSHOT_HDRS_WINDOWS + SNAPSHOT_HDRS_X86,
        "//conditions:default": [],
    }),
    include_prefix = "snapshot",
)

cc_library(
    name = "snapshot_base",
    srcs = SNAPSHOT_SRC_COMMON,
    hdrs = SNAPSHOT_HDRS_COMMON,
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":context",
        ":headers",
        "//client:common",
        "//minidump:headers",
        "//util",
    ],
)

cc_library(
    name = "snapshot_mac",
    srcs = SNAPSHOT_SRC_MAC + SNAPSHOT_SRC_POSIX,
    hdrs = SNAPSHOT_HDRS_MAC + SNAPSHOT_HDRS_POSIX,
    applicable_licenses = ["//third_party/xnu:license"],
    copts = CRASHPAD_COMMON_COPTS,
    target_compatible_with = ["@platforms//os:osx"],
    deps = [":snapshot_base"],
)

cc_library(
    name = "snapshot_linux",
    srcs = SNAPSHOT_SRC_LINUX + SNAPSHOT_SRC_POSIX + SNAPSHOT_SRC_X86,
    hdrs = SNAPSHOT_HDRS_LINUX + SNAPSHOT_HDRS_POSIX + SNAPSHOT_HDRS_X86,
    copts = CRASHPAD_COMMON_COPTS,
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":snapshot_base"],
)

cc_library(
    name = "snapshot_windows",
