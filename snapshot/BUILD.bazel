    hdrs = SNAPSHOT_HDRS_WINDOWS + SNAPSHOT_HDRS_X86,
    copts = CRASHPAD_COMMON_COPTS,
    linkopts = ["/defaultlib:powrprof.lib"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":snapshot_base"],
)

