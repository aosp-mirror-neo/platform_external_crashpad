load("//:copts.bzl", "CRASHPAD_COMMON_COPTS")

licenses(["notice"])

package(
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "tool_support",
    srcs = ["tool_support.cc"],
    hdrs = ["tool_support.h"],
    copts = CRASHPAD_COMMON_COPTS,
    include_prefix = "tools",
    deps = [
        "//:internal",
        "//third_party/mini_chromium:base",
    ],
)

cc_binary(
    name = "dump_minidump_annotations",
    srcs = ["dump_minidump_annotations.cc"],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":tool_support",
        "//client",
        "//snapshot",
        "//util",
    ],
)

cc_binary(
    name = "crashpad_database_util",
    srcs = [
        "crashpad_database_util.cc",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":tool_support",
        "//:internal",
        "//client",
        "//compat",
        "//third_party/mini_chromium:base",
        "//util",
    ],
)

cc_binary(
    name = "crashpad_http_upload",
    srcs = [
        "crashpad_http_upload.cc",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        ":tool_support",
        "//:internal",
        "//compat",
        "//third_party/mini_chromium:base",
        "//util",
    ] + select({
        "@platforms//os:macos": [
            "//util:util_mac",
        ],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "base94_encoder",
    srcs = ["base94_encoder.cc"],
    deps = [
        ":tool_support",
        "//:internal",
        "//third_party/mini_chromium:base",
        "//util",
    ] + select({
        "@platforms//os:macos": [
            "//util:util_mac",
        ],
        "//conditions:default": [],
    }),
)
