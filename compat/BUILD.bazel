load("@rules_cc//cc:cc_library.bzl", "cc_library")

licenses(["notice"])

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = [
        "//:__subpackages__",
    ],
)

COMPAT_LINUX_SOURCES = [
    "linux/sys/mman_memfd_create.cc",
]

COMPAT_LINUX_HEADERS = [
    "linux/signal.h",
    "linux/sys/mman.h",
    "linux/sys/ptrace.h",
    "linux/sys/user.h",
]

COMPAT_APPLE_HEADERS = [
    "mac/Availability.h",
    "mac/AvailabilityVersions.h",
    "mac/kern/exc_resource.h",
    "mac/mach/mach.h",
    "mac/mach-o/loader.h",
    "mac/sys/resource.h",
]

COMPAT_MAC_SOURCES = [
]

COMPAT_MAC_HEADERS = [
    "mac/mach/i386/thread_state.h",
]

COMPAT_NONMAC_SOURCES = [
]

COMPAT_NONMAC_HEADERS = [
    "non_mac/mach/mach.h",
    "non_mac/mach-o/loader.h",
]

COMPAT_WINDOWS_SOURCES = [
    "win/strings.cc",
    "win/time.cc",
]

COMPAT_WINDOWS_HEADERS = [
    "win/getopt.h",
    "win/strings.h",
    "win/sys/time.h",
    "win/sys/types.h",
    "win/time.h",
    "win/winbase.h",
    "win/winnt.h",
    "win/winternl.h",
]

COMPAT_NONWIN_SOURCES = [
    "non_win/minwinbase.h",
    "non_win/timezoneapi.h",
    "non_win/verrsrc.h",
]

COMPAT_NONWIN_HEADERS = [
    "non_win/dbghelp.h",
    "non_win/windows.h",
    "non_win/winnt.h",
]

cc_library(
    name = "compat_interface",
    hdrs = select({
        "@platforms//os:macos": COMPAT_APPLE_HEADERS + COMPAT_MAC_HEADERS +
                                COMPAT_NONWIN_HEADERS,
        "@platforms//os:linux": COMPAT_LINUX_HEADERS +
                                COMPAT_NONWIN_HEADERS,
        "@platforms//os:windows": COMPAT_WINDOWS_HEADERS + COMPAT_NONWIN_HEADERS,
    }),
    includes = select({
        "@platforms//os:macos": ["non_win"],
        "@platforms//os:windows": [
            "win",
        ],
        "@platforms//os:linux": [
            "linux",
            "non_win",
        ],
    }),
    deps = [
        "//:internal",
        "//third_party/mini_chromium:base",
        "//util:no_cfi_icall",
    ] + select({
        "@platforms//os:windows": ["//third_party/getopt"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "compat_nonmac",
    srcs = COMPAT_NONMAC_SOURCES,
    hdrs = COMPAT_NONMAC_HEADERS,
    applicable_licenses = ["//third_party/xnu:license"],
    includes = ["non_mac"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":compat_interface",
        "//third_party/mini_chromium:base",
    ],
)

cc_library(
    name = "compat_mac",
    srcs = COMPAT_MAC_SOURCES,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":compat_interface",
        "//third_party/mini_chromium:base",
    ],
)

cc_library(
    name = "compat",
    srcs = select({
        "@platforms//os:macos": COMPAT_MAC_SOURCES +
                                COMPAT_NONWIN_SOURCES,
        "@platforms//os:windows": COMPAT_WINDOWS_SOURCES,
        "@platforms//os:linux": COMPAT_LINUX_SOURCES +
                                COMPAT_NONWIN_SOURCES,
    }),
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-ldl"],
    }),
    deps = [
        ":compat_interface",
    ] + select({
        "@platforms//os:macos": [":compat_mac"],
        "//conditions:default": [":compat_nonmac"],
    }),
)
