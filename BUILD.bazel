load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

# Description:
#   Crashpad is a crash-reporting system.
load("copts.bzl", "CRASHPAD_COMMON_COPTS")

package(
    default_applicable_licenses = [":license"],
    default_visibility = [
        ":clients",
        "//:__subpackages__",
    ],
)

license(
    name = "license",
    package_name = "crashpad",
    copyright_notice = "Copyright 2014 The Crashpad Authors",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "LICENSE",
    visibility = [":__subpackages__"],
)

# Crashpad itself is licensed under the Apache 2.0 license, but (when built for
# non-Apple systems) has a dependency on a header for the Mach-O loader. This is
# licensed under the APSL 2.0.
licenses(["reciprocal"])

exports_files(["LICENSE"])

package_group(
    name = "clients",
    packages = ["//..."],
)

cc_library(
    name = "internal",
    hdrs = ["package.h"],
    copts = CRASHPAD_COMMON_COPTS,
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "zlib",
    hdrs = ["third_party/zlib/zlib_crashpad.h"],
    include_prefix = "third_party/zlib",
    deps = ["@zlib"],
)

test_suite(
    name = "crashpad_tests",
    tests = [
        "//client:crashpad_client_test",
        "//handler:crashpad_handler_test",
        "//minidump:crashpad_minidump_test",
        "//snapshot:crashpad_snapshot_test",
        "//test:crashpad_test_test",
        "//util:crashpad_util_test",
    ],
)
