# This exists as a separate target from util so that compat may depend on it
# without cycles.
cc_library(
    name = "no_cfi_icall",
    hdrs = ["misc/no_cfi_icall.h"],
    copts = CRASHPAD_COMMON_COPTS + ["-Wno-attributes"],
    deps = ["//third_party/mini_chromium:base"],
)

cc_library(
    name = "util_win",
    srcs = CRASPHAD_UTIL_WINDOWS_ASM,
)

cc_library(
    name = "util_common",
    srcs = CRASHPAD_UTIL_SOURCES,
    hdrs = CRASHPAD_UTIL_HEADERS + select({
        "@platforms//os:linux": ["linux/address_types.h"],
        "@platforms//os:windows": [
            "process/process_memory_win.h",
            "win/address_types.h",
            "win/process_info.h",
            "win/scoped_handle.h",
        ],
        "//conditions:default": [],
    }),
    copts = CRASHPAD_COMMON_COPTS + ["-DZLIB_CONST"],
    include_prefix = "util",
    deps = [
        ":no_cfi_icall",
        "//:internal",
        "//:zlib",
        "//compat",
        "//third_party/mini_chromium:base",
    ],
)

cc_library(
    name = "util_mac",
    srcs = CRASHPAD_UTIL_POSIX_SOURCES + CRASHPAD_UTIL_MACOS_SOURCES,
    hdrs = CRASHPAD_UTIL_MACOS_HEADERS + CRASHPAD_UTIL_POSIX_HEADERS,
    applicable_licenses = ["//third_party/xnu:license"],
    copts = CRASHPAD_COMMON_COPTS + [
        "-DZLIB_CONST",
        "-Wno-deprecated-declarations",
        "-Wno-vla",
    ],
    include_prefix = "util",
    linkopts = [
        "-framework CoreFoundation",
        "-framework Foundation",
        "-framework IOKit",
        "-lbsm",
