load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:copts.bzl", "CRASHPAD_COMMON_COPTS")

licenses(["notice"])

package(
    default_visibility = [
        "//:__subpackages__",
        "//:clients",
    ],
)

cc_library(
    name = "common",
    srcs = [
        "crash_report_upload_thread.cc",
        "minidump_to_upload_parameters.cc",
    ] + select({
        "@platforms//os:macos": ["mac/file_limit_annotation.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "crash_report_upload_thread.h",
        "mac/file_limit_annotation.h",
        "minidump_to_upload_parameters.h",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    include_prefix = "handler",
    deps = [
        # ":common_hdrs",
        "//client:common",
        "//compat",
        "//snapshot",
        "//util",
        "//util:net",
        "//third_party/mini_chromium:base",
    ],
)

cc_library(
    name = "handler",
    srcs = [
        "handler_main.cc",
        "prune_crash_reports_thread.cc",
        "user_stream_data_source.cc",
    ] + select({
        "@platforms//os:osx": [
            "mac/crash_report_exception_handler.cc",
            "mac/exception_handler_server.cc",
        ],
        "@platforms//os:linux": [
            "linux/capture_snapshot.cc",
            "linux/crash_report_exception_handler.cc",
            "linux/cros_crash_report_exception_handler.cc",
            "linux/exception_handler_server.cc",
        ],
        "@platforms//os:windows": [
            "win/crash_report_exception_handler.cc",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "handler_main.h",
        "prune_crash_reports_thread.h",
        "user_stream_data_source.h",
    ] + select({
        "@platforms//os:osx": [
            "mac/crash_report_exception_handler.h",
            "mac/exception_handler_server.h",
        ],
        "@platforms//os:linux": [
            "linux/capture_snapshot.h",
            "linux/crash_report_exception_handler.h",
            "linux/cros_crash_report_exception_handler.h",
            "linux/exception_handler_server.h",
        ],
        "@platforms//os:windows": [
            "win/crash_report_exception_handler.h",
        ],
        "//conditions:default": [],
    }),
    copts = CRASHPAD_COMMON_COPTS + select({
        "@platforms//os:windows": ["/wd4201"],
        "//conditions:default": [],
    }),
    include_prefix = "handler",
    visibility = ["//visibility:public"],
    deps = [
        ":common",
        "//client",
        "//compat",
        "//minidump",
        "//snapshot",
        "//third_party/mini_chromium:base",
        "//tools:tool_support",
        "//util",
    ] + select({
        "@platforms//os:windows": ["//third_party/getopt"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "crashpad_handler",
    srcs = ["main.cc"],
    linkopts =
        select({
            "@platforms//os:windows": [
                # This prevents opening a console window when crashpad_handler.exe runs.
                "/SUBSYSTEM:WINDOWS",
            ],
            "@platforms//os:macos": [
                "-l bsm",
            ],
            "//conditions:default": [],
        }),
    visibility = ["//visibility:public"],
    deps = [
        ":handler",
        "//compat",
        "//third_party/mini_chromium:base",
        "//tools:tool_support",
    ] + select({
        "@platforms//os:linux": [
            "//client:pthread_create",
        ],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "crashpad_handler_console_exe",
    srcs = ["main.cc"],
    linkopts = ["/SUBSYSTEM:CONSOLE"],
    target_compatible_with = [
        "@platforms//os:windows",
    ],
    deps = [
        ":handler",
        "//compat",
        "//third_party/mini_chromium:base",
        "//tools:tool_support",
    ],
)

copy_file(
    name = "crashpad_handler_console",
    src = ":crashpad_handler_console_exe",
    out = "crashpad_handler.com",
)

cc_test(
    name = "crashpad_handler_test",
    srcs = ["minidump_to_upload_parameters_test.cc"] + select({
        "@platforms//os:linux": ["linux/exception_handler_server_test.cc"],
        "//conditions:default": [],
    }),
    copts = CRASHPAD_COMMON_COPTS + select({
        "@platforms//os:linux": ["-Wno-multichar"],
        "//conditions:default": [],
    }),
    deps = [
        ":common",
        ":handler",
        "//:internal",
        "//client",
        "//compat",
        "//minidump:test_support",
        "//snapshot",
        "//snapshot:test_support",
        "//test",
        "//test:googlemock_main",
        "//third_party/mini_chromium:base",
        "//util",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "crashpad_handler_test_extended_handler",
    testonly = True,
    srcs = [
        "crashpad_handler_test_extended_handler.cc",
    ],
    copts = CRASHPAD_COMMON_COPTS,
    deps = [
        "//:internal",
        "//compat",
        "//minidump:test_support",
        "//third_party/mini_chromium:base",
        "//tools:tool_support",
    ],
)

cc_binary(
    name = "fake_handler_that_crashes_at_startup",
    testonly = True,
    srcs = ["win/fake_handler_that_crashes_at_startup.cc"],
    target_compatible_with = [
        "@platforms//os:windows",
    ],
)
